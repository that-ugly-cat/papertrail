# Required. Generate with:  openssl rand -hex 32
JWT_SECRET=

# Set to 0 only when serving over plain HTTP (local dev). In production Caddy
# terminates TLS, so leave it at 1 or the session cookie travels unprotected.
COOKIE_SECURE=1

PUBLIC_URL=https://papertrail.borant.eu

# Optional override; the default lands in the mounted ./data volume.
# DATABASE_URL=sqlite:///./data/papertrail.db
